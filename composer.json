{
    "name": "opencoreemr/oe-module-calendar",
    "description": "Connect OpenEMR to OpenCoreEMR Calendar",
    "type": "openemr-module",
    "require": {
        "openemr/oe-module-installer-plugin": "^0.1.5",
        "php": ">=8.1",
        "nyholm/psr7": "^1.5",
        "symfony/event-dispatcher": "^4.4 || ^5.0 || ^6.0 || ^7.0"
    },
    "conflict": {
        "openemr/openemr": "<7.0.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.12",
        "phpunit/phpunit": "^12.1"
    },
    "autoload": {
        "psr-4": {
            "OpenCoreEmr\\OeModuleOceCal\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Michael A. Smith",
            "email": "michael@smith-li.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "openemr/oe-module-installer-plugin": true
        }
    }
}
